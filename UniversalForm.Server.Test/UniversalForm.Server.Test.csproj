<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RunPostBuildEvent>Always</RunPostBuildEvent>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="MSTest" Version="3.6.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UniversalForm.Server.Model\UniversalForm.Server.Model.csproj" />
    <ProjectReference Include="..\UniversalForm.Server.Persistence\UniversalForm.Server.Persistence.csproj" />
    <ProjectReference Include="..\UniversalForm.Server.View\UniversalForm.Server.View.csproj" />
    <ProjectReference Include="..\UniversalForms.TestUtils\UniversalForms.TestUtils.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="echo deleting Test folder&#xD;&#xA;rmdir /S /Q &quot;$(TargetDir)\Test&quot;&#xD;&#xA;echo Copying Test folder&#xD;&#xA;mkdir &quot;$(TargetDir)\Test&quot;&#xD;&#xA;xcopy /E /H /Y &quot;$(ProjectDir)\Test&quot; &quot;$(TargetDir)\Test&quot;&#xD;&#xA;" />
  </Target>

</Project>
